{
  "name": "@herbcaudill/easy-api-key",
  "version": "0.2.0",
  "description": "Password-encrypt API keys and secrets for bundling with your app",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./node": {
      "import": {
        "types": "./dist/node.d.ts",
        "default": "./dist/node.js"
      },
      "require": {
        "types": "./dist/node.d.cts",
        "default": "./dist/node.cjs"
      }
    }
  },
  "bin": {
    "easy-api-key": "./bin/encrypt.js"
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "prepublishOnly": "pnpm build"
  },
  "keywords": [
    "encryption",
    "api-key",
    "secret",
    "password",
    "aes",
    "crypto"
  ],
  "author": "Herb Caudill",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "jsdom": "^27.4.0",
    "prettier": "^3.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
